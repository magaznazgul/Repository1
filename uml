@startuml

skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor #E8F8F5
    BorderColor #368B85
}

class Main {
    - tableCombo : JComboBox
    - columnList : JList
    - conditionsPanel : JPanel
    - resultArea : JTextArea
    - tableColumns : Map

    + Main()
    - createInterface() : void
    - initializeTableColumns() : void
    - updateColumns() : void
    - addConditionRow() : void
    - removeConditionRow() : void
    - generateQuery() : void
    - clearAll() : void
    - copyResult() : void
}

class ConditionRow {
    + panel : JPanel
    + columnCombo : JComboBox
    + operatorCombo : JComboBox
    + valueField : JTextField
    + logicCombo : JComboBox

    + ConditionRow()
    + updateColumns() : void
}

interface QueryBuilder {
    + from(table : String) : QueryBuilder
    + select(columns : String[]) : QueryBuilder
    + where(column : String, operator : String, value : Object) : QueryBuilder
    + where(column : String, operator : String, value : Object, logic : String) : QueryBuilder
    + orderBy(column : String, direction : String) : QueryBuilder
    + limit(limit : int) : QueryBuilder
    + build() : String
}

class SQLQueryBuilder {
    - table : String
    - selectedColumns : List
    - conditions : List
    - orderColumn : String
    - orderDirection : String
    - limitValue : Integer
    - parameters : List

    + from(table : String) : QueryBuilder
    + select(columns : String[]) : QueryBuilder
    + where(column : String, operator : String, value : Object) : QueryBuilder
    + where(column : String, operator : String, value : Object, logic : String) : QueryBuilder
    + orderBy(column : String, direction : String) : QueryBuilder
    + limit(limit : int) : QueryBuilder
    + build() : String
    + getParameters() : List
    - checkColumn(column : String) : void
}

class Condition {
    + column : String
    + operator : String
    + value : Object
    + logic : String

    + Condition(column, operator, value, logic)
}

Main *-- ConditionRow
Main ..> SQLQueryBuilder : creates
SQLQueryBuilder ..|> QueryBuilder : implements
SQLQueryBuilder *-- Condition : contains

@enduml
